{
  "name": "@gitblogapp/cli",
  "version": "0.1.1",
  "type": "module",
  "description": "Framework-independent GitBlog cli",
  "engines": {
    "node": ">=24.12.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "dependencies": {
    "marked": "^18.0.0",
    "gray-matter": "^4.0.3",
    "sharp": "0.35.5",
    "robots-parser": "^3.0.1",
    "js-yaml": "4.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitblogapp/gitblog-template-packages.git",
    "directory": "packages/cli"
  },
  "bin": {
    "gitblog": "dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gitblogapp/gitblog-template-packages#readme",
  "bugs": {
    "url": "https://github.com/gitblogapp/gitblog-template-packages/issues"
  }
}
